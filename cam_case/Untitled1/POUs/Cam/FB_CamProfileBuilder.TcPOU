<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_CamProfileBuilder" Id="{826f8add-1c54-4d46-9098-59ce43213ef1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_CamProfileBuilder
VAR_INPUT
    bExecute : BOOL;
    stRecipe : ST_CamRecipe;
    stDerived : ST_CamDerivedGeometry;
END_VAR
VAR_OUTPUT
    bDone : BOOL;
    aPoints : ARRAY[1..8] OF MC_MotionFunctionPoint;
    stCamRef : MC_CAM_REF;
END_VAR
VAR
    rtExecute : R_TRIG;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[rtExecute(CLK := bExecute);
bDone := FALSE;

IF rtExecute.Q THEN
    aPoints[1] := F_MakeCamPoint(1, MOTIONFUNCTYPE_POLYNOM5_MM,
        MOTIONPOINTTYPE_REST, 1, 0.0, 0.0, 0.0);
    aPoints[2] := F_MakeCamPoint(2, MOTIONFUNCTYPE_POLYNOM1,
        MOTIONPOINTTYPE_VELOCITY, 1, stRecipe.lrFirstEdgeStart,
        stDerived.lrFirstStartY, stDerived.lrFirstSlope);
    aPoints[3] := F_MakeCamPoint(3, MOTIONFUNCTYPE_POLYNOM5_MM,
        MOTIONPOINTTYPE_VELOCITY, 1, stDerived.lrFirstEdgeEnd,
        stDerived.lrFirstEndY, stDerived.lrFirstSlope);
    aPoints[4] := F_MakeCamPoint(4, MOTIONFUNCTYPE_POLYNOM1,
        MOTIONPOINTTYPE_VELOCITY, 1,
        stDerived.lrInterEdgeTransitionEnd,
        stDerived.lrTransitionEndY, stDerived.lrSecondSlope);
    aPoints[5] := F_MakeCamPoint(5, MOTIONFUNCTYPE_POLYNOM5_MM,
        MOTIONPOINTTYPE_VELOCITY, 1, stDerived.lrSecondEdgeEnd,
        stDerived.lrSecondEndY, stDerived.lrSecondSlope);
    aPoints[6] := F_MakeCamPoint(6, MOTIONFUNCTYPE_POLYNOM5_MM,
        MOTIONPOINTTYPE_REST, 1, stDerived.lrExitEnd,
        stDerived.lrExitEndY, 0.0);
    aPoints[7] := F_MakeCamPoint(7, MOTIONFUNCTYPE_POLYNOM1,
        MOTIONPOINTTYPE_REST, 1, stRecipe.lrReturnEndPhase, 0.0, 0.0);
    aPoints[8] := F_MakeCamPoint(8, MOTIONFUNCTYPE_NOTDEF,
        MOTIONPOINTTYPE_REST, 0, stRecipe.lrObjectPitch, 0.0, 0.0);

    stCamRef.pArray := ADR(aPoints);
    stCamRef.ArraySize := SIZEOF(aPoints);
    stCamRef.TableType := MC_TABLETYPE_MOTIONFUNCTION;
    stCamRef.NoOfRows := 8;
    stCamRef.NoOfColumns := 1;
    bDone := TRUE;
END_IF;
]]></ST>
    </Implementation>
    <LineIds Name="FB_CamProfileBuilder">
      <LineId Id="1" Count="0" />
      <LineId Id="4" Count="37" />
      <LineId Id="2" Count="0" />
    </LineIds>
  </POU>
</TcPlcObject>
